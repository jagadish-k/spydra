{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "Spydra design tokens. Light is the default theme; the dark extension overrides surfaces and lifts state hues without changing them.",
  "brand": {
    "$type": "color",
    "$description": "Actions, focus, active navigation. Never used to carry state or data.",
    "50":  { "$value": "#EEF0FB" },
    "100": { "$value": "#DDE1F7" },
    "200": { "$value": "#BFC6F0" },
    "300": { "$value": "#9AA4E6" },
    "400": { "$value": "#727FDF" },
    "500": { "$value": "#4F56D9" },
    "600": { "$value": "#4338CA", "$description": "Primary buttons, active nav" },
    "700": { "$value": "#3730A3", "$description": "Hover" },
    "800": { "$value": "#2E2A83" },
    "900": { "$value": "#262369" }
  },
  "neutral": {
    "$type": "color",
    "0":   { "$value": "#FFFFFF" },
    "25":  { "$value": "#FBFBFC" },
    "50":  { "$value": "#F7F8FA" },
    "100": { "$value": "#F1F3F6" },
    "200": { "$value": "#E3E6EB" },
    "300": { "$value": "#CDD2DA" },
    "400": { "$value": "#A8AEB9" },
    "500": { "$value": "#878E9A" },
    "600": { "$value": "#5A616D" },
    "700": { "$value": "#3F4550" },
    "800": { "$value": "#272C36" },
    "900": { "$value": "#16191F" },
    "950": { "$value": "#0F1115" }
  },
  "state": {
    "$type": "color",
    "$description": "Domain lifecycle. The only semantic use of colour in the product.",
    "discovered": { "$value": "#6B7280", "$description": "Seeded, nothing known yet" },
    "pending":    { "$value": "#B45309", "$description": "Awaiting your approval" },
    "active":     { "$value": "#047857", "$description": "Approved template, crawling" },
    "broken":     { "$value": "#B91C1C", "$description": "Validation failures over threshold" },
    "paused":     { "$value": "#C2410C", "$description": "Stopped deliberately or auto-paused" },
    "archived":   { "$value": "#9CA3AF", "$description": "Retired, data retained" }
  },
  "viz": {
    "$type": "color",
    "$description": "Categorical series, ordered for adjacent separation and checked for deuteranopia.",
    "1": { "$value": "#4F56D9" },
    "2": { "$value": "#0E9F6E" },
    "3": { "$value": "#D97706" },
    "4": { "$value": "#9333EA" },
    "5": { "$value": "#0891B2" },
    "6": { "$value": "#DC2626" }
  },
  "font": {
    "$type": "fontFamily",
    "ui":    { "$value": ["Inter var", "Inter", "-apple-system", "sans-serif"] },
    "mono":  { "$value": ["JetBrains Mono", "ui-monospace", "Menlo", "monospace"] },
    "brand": { "$value": ["Space Grotesk", "Inter", "sans-serif"], "$description": "Wordmark only — never in the interface" }
  },
  "fontSize": {
    "$type": "dimension",
    "$description": "Base 14px. Dense operational UI; 16px wastes a third of every table row.",
    "2xs": { "$value": "11px", "$description": "Badges, micro-labels" },
    "xs":  { "$value": "12px", "$description": "Metadata, timestamps" },
    "sm":  { "$value": "13px", "$description": "Table body, dense lists" },
    "md":  { "$value": "14px", "$description": "Body default, form inputs" },
    "lg":  { "$value": "16px", "$description": "Card titles" },
    "xl":  { "$value": "20px", "$description": "Screen headings" },
    "2xl": { "$value": "28px", "$description": "Page titles, sparing" }
  },
  "fontWeight": {
    "$type": "fontWeight",
    "normal": { "$value": 400 },
    "medium": { "$value": 500, "$description": "Table headers, labels" },
    "semi":   { "$value": 600, "$description": "Headings, emphasis. Nothing heavier." }
  },
  "space": {
    "$type": "dimension",
    "$description": "4px base unit; component padding on an 8px rhythm.",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" }
  },
  "radius": {
    "$type": "dimension",
    "xs":   { "$value": "3px" },
    "sm":   { "$value": "4px", "$description": "Badges" },
    "md":   { "$value": "6px", "$description": "Controls, inputs" },
    "lg":   { "$value": "8px", "$description": "Cards, panels" },
    "xl":   { "$value": "12px", "$description": "Modal" },
    "full": { "$value": "999px", "$description": "Status dots only" }
  },
  "duration": {
    "$type": "duration",
    "fast":  { "$value": "120ms" },
    "base":  { "$value": "160ms" },
    "flash": { "$value": "400ms", "$description": "Changed-row background flash" }
  },
  "layout": {
    "$type": "dimension",
    "sidebarWidth":     { "$value": "240px" },
    "sidebarCollapsed": { "$value": "56px" },
    "topbarHeight":     { "$value": "52px" },
    "rowComfortable":   { "$value": "36px" },
    "rowCompact":       { "$value": "28px" }
  }
}
