# Spydra — local development configuration. Nothing here is secret: this is a
# localhost tool with no third-party credentials (DEVELOPMENT.md §
# Configuration). If that ever changes, the secret does not go in the repo.

LOG_LEVEL=info
SPYDRA_DATA=./.data            # host path for /data
# RENDER_BASE_URL / LLM_BASE_URL are hardcoded literals in compose.yaml's
# environment (RENDER_BASE_URL on the worker only, over render-link — ADR-0038). These lines
# document them for anything running OUTSIDE compose; editing them in .env
# does not change the containers.
RENDER_BASE_URL=http://render:3001   # over render-link — ADR-0038
LLM_BASE_URL=http://host.docker.internal:8080
LLM_MODEL=qwen3-coder-30b-a3b  # qwen3-coder-8b when developing on a laptop
LLM_SAMPLES=5                  # ADR-0020; 3 while iterating on a laptop
SKELETON_MAX_NODES=3000        # spec 007 §2; 1200 on a laptop
RENDER_CONTEXTS=3              # the sidecar's hard cap
ASSET_BOX=1200x1200
HTML_TTL_DAYS=7
PAGE_WORKERS=12
# ADR-0004 — a descriptive user-agent with contact information, sent on every
# request and matched against robots.txt (spec 002 §5). Per-domain overrides
# live in domains.user_agent; this is the default and the robots token.
USER_AGENT=MySampleScraper/1.0 (+https://jagadishk.work; k.jagdish@gmail.com)
ASSET_WORKERS=24
