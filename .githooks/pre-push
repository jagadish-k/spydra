#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# Spydra pre-push — the real gate. Budget: 3 minutes.
#
# `make check` is exactly what CI runs, in the same images, so green here
# means green there. This is the contract between one agent and the next
# (ADR-0022 §3): a slice is handed on when the gate passes, not when someone
# says it is done.
# ---------------------------------------------------------------------------
set -uo pipefail

RED=$'\033[0;31m'; GRN=$'\033[0;32m'; YEL=$'\033[0;33m'; OFF=$'\033[0m'

# Protection is a property of the ref being WRITTEN, not of the one checked
# out. git feeds pre-push one line per ref on stdin —
#   <local_ref> <local_sha> <remote_ref> <remote_sha>
# — so this catches `git push origin HEAD:develop` from a feature branch,
# which comparing $(git rev-parse --abbrev-ref HEAD) waved straight through
# (phase-0 audit, finding F1).
refused() {
  echo "${RED}✗ ${1} is protected. Work on type/NN-slug and open a PR (WORKFLOW.md §1).${OFF}" >&2
  exit 1
}

untested() {
  echo "${RED}✗ make check would test a tree you are not pushing: ${1}${OFF}" >&2
  echo "  ${2}" >&2
  exit 1
}

ZERO=0000000000000000000000000000000000000000
head_sha=$(git rev-parse HEAD)
refs_seen=0
while read -r local_ref local_sha remote_ref _remote_sha; do
  refs_seen=1
  case "$remote_ref" in
    refs/heads/develop|refs/heads/main) refused "${remote_ref#refs/heads/}" ;;
  esac
  # `make check` runs against the working tree, so it only vouches for the
  # commit that tree is. Pushing another branch from here — the routine move
  # when a stack is rebased and force-pushed from one checkout — ran the gate
  # on the wrong commit and let 1.9 ship without its regenerated crawl mirror,
  # which CI then failed on #13 and #14. Deletions carry no tree to test.
  if [ "$local_sha" != "$ZERO" ] && [ "$local_sha" != "$head_sha" ]; then
    untested "${local_ref#refs/heads/} is at ${local_sha:0:7}, HEAD is ${head_sha:0:7}." \
      "Check out ${local_ref#refs/heads/} and push from there."
  fi
done

# No refs on stdin means the hook was invoked by hand, not by a push. Fall
# back to the checked-out branch so a manual run still says something useful.
if [ "$refs_seen" -eq 0 ]; then
  branch=$(git rev-parse --abbrev-ref HEAD)
  case "$branch" in develop|main) refused "$branch" ;; esac
fi

# The same failure from the other side: an uncommitted regenerated file, or an
# untracked migration, makes the gate green on a tree the commit is not.
# Untracked files count — alembic and pytest both pick up a file git ignores
# the existence of.
dirty=$(git status --porcelain --untracked-files=normal)
if [ -n "$dirty" ]; then
  untested "the working tree has changes HEAD does not." \
    "Commit them, or 'git stash -u', then push again:
$(echo "$dirty" | head -20 | sed 's/^/    /')"
fi

if [ ! -f Makefile ] || ! grep -qE '^check:' Makefile; then
  echo "${YEL}·${OFF} no 'make check' yet — scaffolding in progress. Skipping."
  exit 0
fi

echo "${YEL}·${OFF} make check  (lint · types · generated-file drift · tests)"
if ! make -s check; then
  echo "${RED}✗ make check failed. This is what CI will run.${OFF}" >&2
  exit 1
fi

echo "${GRN}✓${OFF} pre-push"
exit 0
