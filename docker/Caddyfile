# Spydra edge — one origin, four routes (spec 010 §2).
#
# The three load-bearing lines, all easy to break by "tidying":
#   1. the SSE handle comes BEFORE handle /api/crawler/* — the first
#      matching handle wins and the general rule would buffer the stream;
#   2. flush_interval -1 — without it Caddy buffers and SSE arrives in
#      chunks or not at all. This presents as a frontend bug (spec 010).
#   3. `encode` must NOT see the event stream. A site-wide `encode zstd gzip`
#      compresses text/event-stream, which reintroduces buffering through the
#      compressor and is invisible to any curl that does not send
#      Accept-Encoding — a browser always sends it (phase-0 audit, F3).

:8080 {
	# Everything except the event stream is compressible. Excluding by PATH
	# rather than content-type keeps this readable against the handles below,
	# and there is exactly one streaming route.
	@compressible not path /api/crawler/runs/*/events
	encode @compressible zstd gzip

	# SSE: straight to Python, no BFF hop, no buffering.
	handle /api/crawler/runs/*/events {
		reverse_proxy api:8000 {
			flush_interval -1
			transport http {
				response_header_timeout 24h
			}
		}
	}

	handle /api/crawler/* {
		reverse_proxy api:8000
	}

	handle /api/ui/* {
		reverse_proxy bff:3000
	}

	handle {
		reverse_proxy web:5173        # prod: file_server from the built SPA
	}
}
